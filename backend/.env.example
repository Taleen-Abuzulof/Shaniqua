# Supabase Postgres connection string.
# Use the direct or session-pooler string (port 5432), not the transaction pooler,
# since drizzle-orm/node-postgres needs a session-scoped connection.
DATABASE_URL=

# Supabase project settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: server-side only, bypasses RLS. Never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
