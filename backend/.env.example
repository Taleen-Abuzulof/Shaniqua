# Supabase Postgres connection string.
# Use the direct or session-pooler string (port 5432), not the transaction pooler,
# since drizzle-orm/node-postgres needs a session-scoped connection.
DATABASE_URL=

# Supabase project settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: server-side only, bypasses RLS. Never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Port the API server listens on. Defaults to 4000 (Next.js dev server takes 3000).
PORT=4000
# Origin allowed to call this API with credentials.
FRONTEND_URL=http://localhost:3000

# Instagram API with Instagram Login: Meta app dashboard -> Instagram -> API setup
# with Instagram business login. Use the *Instagram* app ID/secret, not the Facebook app's.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match a redirect URI registered in the Meta app (Instagram requires
# https, so use a tunnel like ngrok for local dev). Defaults to
# ${FRONTEND_URL}/connect/instagram/callback.
INSTAGRAM_REDIRECT_URI=
# Graph API version for graph.instagram.com calls.
INSTAGRAM_GRAPH_VERSION=v25.0

# 32 random bytes, base64, for encrypting Instagram tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored tokens unreadable (users must reconnect).
TOKEN_ENCRYPTION_KEY=
# Signs the short-lived OAuth state cookie. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OAUTH_STATE_SECRET=
